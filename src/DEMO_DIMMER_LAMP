#include <Wire.h>
#include "RTClib.h"
#include <Adafruit_NeoPixel.h>

// ----- PIN SETUP -----
#define NEOPIXEL_PIN 6
#define NUMPIXELS 16
#define BUTTON_PIN 7

// ----- OBJECTS -----
RTC_DS3231 rtc;
Adafruit_NeoPixel pixels(NUMPIXELS, NEOPIXEL_PIN, NEO_GRB + NEO_KHZ800);

// ----- GLOBAL FLAGS -----
bool cycleActive = false;
unsigned long lastPressTime = 0;

// ----- TIMINGS (milliseconds) -----
// DEMO VERSION: 30 + 30 + 30 seconds
const unsigned long fadeDuration = 30000UL;   // 30 s fade
const unsigned long waitDuration = 30000UL;   // 30 s off

// ----- SETUP -----
void setup() {
  Serial.begin(9600);
  delay(1000);

  pinMode(BUTTON_PIN, INPUT_PULLUP);

  Wire.begin();
  rtc.begin();

  pixels.begin();
  pixels.show(); // clear LEDs

  Serial.println("Demo mode ready. Press button to start.");
}

// ----- MAIN LOOP -----
void loop() {
  if (digitalRead(BUTTON_PIN) == LOW && millis() - lastPressTime > 400) {
    lastPressTime = millis();
    cycleActive = !cycleActive;
    Serial.println(cycleActive ? "Cycle STARTED" : "Cycle STOPPED");

    if (cycleActive) flashIndicator();
    else setBrightness(0);
  }

  if (cycleActive) {
    runLightCycle();
  }

  delay(50);
}

// ----- MAIN LIGHT CYCLE -----
void runLightCycle() {
  Serial.println("Fading DOWN...");
  fadeBrightness(255, 0, fadeDuration);

  if (!cycleActive) return;

  Serial.println("Off period...");
  waitWithButtonCheck(waitDuration);

  if (!cycleActive) return;

  Serial.println("Fading UP...");
  fadeBrightness(0, 255, fadeDuration);

  if (!cycleActive) return;

  Serial.println("Cycle complete. Stopping...");

  // Pärast tsükli lõppu kustuta LEDid
  setBrightness(0);

  // Lõpetame tsükli, ei kordu enam
  cycleActive = false;
}

// ----- STARTUP FLASH -----
void flashIndicator() {
  setBrightness(255);
  delay(1000);
  setBrightness(0);
  delay(300);
}

// ----- FADE FUNCTION -----
void fadeBrightness(int startValue, int endValue, unsigned long duration) {
  unsigned long startTime = millis();
  
  while (millis() - startTime < duration && cycleActive) {
    float progress = float(millis() - startTime) / duration;
    int brightness = startValue + (endValue - startValue) * progress;

    setBrightness(brightness);
    delay(50); // smoother for short demo
  }
  
  setBrightness(endValue);
}

// ----- SET BRIGHTNESS -----
void setBrightness(int level) {
  int r = level;
  int g = level * 0.8;
  int b = level * 0.5;

  for (int i = 0; i < NUMPIXELS; i++) {
    pixels.setPixelColor(i, pixels.Color(r, g, b));
  }
  pixels.show();
}

// ----- CANCELABLE WAIT -----
void waitWithButtonCheck(unsigned long duration) {
  unsigned long startTime = millis();
  
  while (millis() - startTime < duration && cycleActive) {
    if (digitalRead(BUTTON_PIN) == LOW && millis() - lastPressTime > 400) {
      lastPressTime = millis();
      cycleActive = false;
      Serial.println("Cycle stopped during wait.");
      break;
    }
    delay(100);
  }
}
